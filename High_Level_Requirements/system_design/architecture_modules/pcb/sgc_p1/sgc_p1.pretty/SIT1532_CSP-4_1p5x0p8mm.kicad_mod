  (fp_circle (center -0.5 0.205) (end -0.44 0.205) (stroke (width 0.05) (type solid)) (fill none) (layer "F.Fab"))
  (fp_line (start -0.88 -0.5) (end 0.88 -0.5) (stroke (width 0.05) (type solid)) (layer "F.CrtYd"))
  (fp_line (start 0.88 -0.5) (end 0.88 0.5) (stroke (width 0.05) (type solid)) (layer "F.CrtYd"))
