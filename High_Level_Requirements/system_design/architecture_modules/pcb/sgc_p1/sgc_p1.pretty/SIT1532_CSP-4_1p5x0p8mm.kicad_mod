(module "SIT1532_CSP-4_1p5x0p8mm" (version 20221018) (generator pcbnew)
  (layer "F.Cu")
  (descr "SiTime SiT1532 32.768kHz MEMS oscillator, 4-LD CSP 1.5x0.8x0.55mm (POD-35 Rev A). Land pattern from datasheet 'Dimensions and Patterns' p.9: 4x NSMD round pads D0.25, soldermask openings D0.35, ball pitch e=0.41 (Y) / e1=1.00 (X) BSC, ball-to-center SD=0.205 (Y) / SE=0.500 (X) BSC. Pad map from the figure: #4 TL, #3 TR, #1 BL, #2 BR. Pins: 1=ST, 2=GND, 3=OUT, 4=VDD. Extracted 2026-11-05 from sitime.com SiT1532 rev 2.0 (curl + pypdfium2 + text-rect positions).")
  (tags "oscillator 32.768kHz MEMS CSP SiT1532 SiTime")
