(footprint "MountingHole_1.6mm"
	(version 20260206)
	(generator "sgc_p1 generator")
	(layer "F.Cu")
	(descr "Mounting Hole 1.6mm, no annular ring, NPTH. Generated for SGC P1 (MH1/MH2 pogo-jig registration). Not present in KiCad's stock MountingHole library.")
	(tags "mountinghole NPTH 1.6mm jig registration")
	(attr exclude_from_pos_files exclude_from_bom)
	(fp_circle
		(center 0 0)
		(end 1.6 0)
		(stroke (width 0.15) (type solid))
		(fill no)
		(layer "Cmts.User")
	)
	(fp_circle
		(center 0 0)
		(end 1.85 0)
		(stroke (width 0.05) (type solid))
		(fill no)
		(layer "F.CrtYd")
	)
	(fp_text user "${REFERENCE}"
		(at 0 0 0)
		(layer "F.Fab")
		(effects (font (size 1 1) (thickness 0.15)))
	)
	(pad "" np_thru_hole circle
		(at 0 0)
		(size 1.6 1.6)
		(drill 1.6)
		(layers "*.Cu" "*.Mask")
	)
	(embedded_fonts no)
)
