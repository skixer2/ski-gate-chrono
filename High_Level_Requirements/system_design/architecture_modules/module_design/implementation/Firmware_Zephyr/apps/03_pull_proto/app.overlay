/*
 * Devicetree patch for THIS app only (board files stay untouched).
 *
 * The Nicla has no plain GPIO LED: its RGB LED hangs on the IS31FL3194
 * I2C chip at address 0x53 on I2C0 (TWIM0 @ 0x40003000), which the
 * board file already declares as a node named "led_rgb" — but WITHOUT
 * a devicetree label, so &led_rgb cannot be used. We therefore point
 * the standard alias "led0" at the node by full path.
 *
 * Our code then requests the LED with DT_ALIAS(led0), which is the
 * canonical Zephyr pattern and stays stable even if we later swap
 * boards (the overlay, not the code, absorbs the hardware detail).
 */
/ {
	aliases {
		led0 = &{/soc/i2c@40003000/is31fl3194@53/led_rgb};
	};
};


/*
 * BHI260AP smart sensor hub (M3 step 2). Second device on the physical
 * SPI0 bus (= &spi2, already enabled for the NOR flash): SCK P0.03 /
 * MOSI P0.04 / MISO P0.05 shared, CS P0.31 dedicated ("CS BHI260",
 * Arduino variant pin 17 — NOT P0.29, which is SPI1's header CS1).
 * 16 MHz (Arduino library clock). Host interrupt P0.14 (unused Phase A).
 */
&spi2 {
	/* BOTH chip selects on the controller: reg=<0> selects the first
	 * (flash, P0.26 — unchanged from the board file), reg=<1> selects
	 * the second (BHI260, P0.31 — our addition). */
	cs-gpios = <&gpio0 26 GPIO_ACTIVE_LOW>, <&gpio0 31 GPIO_ACTIVE_LOW>;

	bhi260: bhi260@1 {
		compatible = "bosch,bhi260ap";
		reg = <1>;
		spi-max-frequency = <16000000>;
	/* Hard reset line of the hub: BHI260 RESET pin 9 = Arduino variant
	 * pin 13 = P0.18 (see variant.cpp:91). Arduino never drives it (PCB
	 * pull-up holds it high); we pulse it low at bring-up to clear any
	 * garbage-latched state. NOTE: kept in code, not DT — the upstream
	 * bosch,bhi260ap binding silently drops non-standard properties
	 * (reset-gpios) at gen_defines time. */
		status = "okay";
	};
};

/*
 * F03 arming button (2026-10-14): monostable switch / piezo on P0.02,
 * closed to GND. Zephyr pin numbers are PHYSICAL nRF pins — pin 2
 * IS P0.02 (not the Arduino numbering trap).
 */
/ {
	aliases {
		wake-button = &wake_button;   /* DT_ALIAS(wake_button) */
	};

	wake_button: wake_button {
		/* Plain node (no gpio-keys binding — that needs a parent
		 * container in Zephyr 4.4); the driver reads gpios +
		 * gpio-pull-up directly via DT_ALIAS. */
		status = "okay";
		gpios = <&gpio0 2 GPIO_ACTIVE_LOW>;
		gpio-pull-up;          /* internal pull-up, switch to GND */
	};
};
