# secrets.example.env - PLACEHOLDERS ONLY. No real credentials, ever.
#
# Copy to secrets.env (gitignored) if you want; or set env vars in PowerShell.
# NEVER commit secrets.env, *.pem, or id_* private keys.
#
# Hostinger layout: OpenClaw container sees /home/node/.openclaw/workspace
# but on the VPS HOST that tree is /root/.openclaw/workspace (bind mount).
# Push to the HOST path as root (key auth).

SGC_RESULTS_HOST=72.60.88.60
SGC_RESULTS_PORT=22
SGC_RESULTS_USER=root
SGC_RESULTS_PATH=/root/.openclaw/workspace/ski_gate_chrono/High_Level_Requirements/system_design/architecture_modules/module_design/unit_tests/tmp_test_results
SGC_RESULTS_KEY=C:\Users\YOU\.ssh\id_ed25519_sgc
