*.o
*.a

# Phone app
android/.gradle/
android/app/build/
android/build/
android/local.properties
.gradle/
.dart_tool/
.packages
pubspec.lock

# IDE / OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# Generated
*.log
*.tmp

# Flutter generated
.flutter-plugins
.flutter-plugins-dependencies
android/local.properties
android/app/src/main/java/io/flutter/plugins/GeneratedPluginRegistrant.java

# Test results (runtime artifacts)
**/test/results/
*.ndjson
*.png

# Local harness run summaries / logs (machine-generated)
High_Level_Requirements/system_design/architecture_modules/module_design/unit_tests/run_*.md
High_Level_Requirements/system_design/architecture_modules/module_design/unit_tests/run_*.log

# Release-test packaging / links (machine-generated, keep local)
High_Level_Requirements/system_design/architecture_modules/module_design/unit_tests/pack_release_*.ps1
High_Level_Requirements/system_design/architecture_modules/module_design/unit_tests/release_tests_*_link

# Raw hex dumps (runtime test artifacts)
High_Level_Requirements/system_design/system_tests/results/*.txt

# KiCad local/transient files - never design sources.
# .history/ is KiCad's own backup dir: it is a NESTED GIT REPO, so `git add`
# reports "adding embedded git repository" and drags it in by accident.
.history/
*.kicad_prl
_autosave-*
fp-info-cache
*-backups/
*.lck
~*.lck
# KiCad crash/autosave copies of sheets (real sheets are never suffixed)
*.kicad_sch.corrupt-*

# SSH keys / secrets (never commit)
**/secrets.env
**/*_sgc
**/id_ed25519_sgc
**/id_ed25519_sgc.pub
tmp_test_results/
